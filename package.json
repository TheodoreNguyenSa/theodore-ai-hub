{
  "name": "theodore-ai-hub",
  "version": "0.1.0",
  "private": true,
  "description": "Theodore AI Hub: work across AI coding CLIs (Claude Code, Codex, Gemini CLI, Antigravity) on Windows: threads, handoff, approvals, artifacts, skills",
  "type": "module",
  "engines": {
    "node": ">=20.10"
  },
  "scripts": {
    "serve": "node server/index.mjs serve --open",
    "serve:fake": "node server/index.mjs serve --open --fake-agents",
    "test": "node --test --test-force-exit --test-timeout=120000 --test-reporter=spec \"test/*.test.mjs\"",
    "probe": "node tools/live-probe.mjs",
    "fetch-node": "node scripts/fetch-node.mjs",
    "stage": "node scripts/stage.mjs",
    "desktop:dev": "node scripts/stage.mjs && tauri dev",
    "build:win": "node scripts/fetch-node.mjs --platform win32 --arch x64 && node scripts/stage.mjs --platform win32 --arch x64 && tauri build",
    "tauri": "tauri"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "1.1.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4"
  }
}
