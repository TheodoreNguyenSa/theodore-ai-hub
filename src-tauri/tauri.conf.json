{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Relay",
  "version": "0.1.0",
  "identifier": "app.relay.desktop",
  "build": {
    "frontendDist": "../desktop"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null,
      "capabilities": [
        "main"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "publisher": "Relay",
    "shortDescription": "Work across AI coding CLIs on Windows",
    "longDescription": "Relay runs Claude Code, Codex, Gemini CLI and Antigravity side by side: every chat in one window, hand work from one agent to another, answer their permission prompts from one inbox, and keep their artifacts and skills in one place.",
    "category": "DeveloperTool",
    "copyright": "",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../build/app/": "app/",
      "../build/node/": "node/"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      },
      "wix": {
        "language": [
          "en-US"
        ]
      }
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}