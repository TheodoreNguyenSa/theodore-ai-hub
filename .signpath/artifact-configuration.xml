<?xml version="1.0" encoding="utf-8"?>
<!--
  What SignPath signs in the artifact the workflow uploads (theodore-ai-hub-windows-x64):
  the zip holds nsis/<name>-setup.exe and msi/<name>.msi. Paste this into the project's
  artifact configuration on signpath.io (SignPath support can adjust it during onboarding).
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <directory path="nsis">
      <pe-file-set>
        <include path="*.exe" />
        <for-each>
          <authenticode-sign />
        </for-each>
      </pe-file-set>
    </directory>
    <directory path="msi">
      <msi-file-set>
        <include path="*.msi" />
        <for-each>
          <authenticode-sign />
        </for-each>
      </msi-file-set>
    </directory>
  </zip-file>
</artifact-configuration>
